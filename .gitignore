# Build output
/build/
/out/
/dist/
/web/client/node_modules/
/web/client/dist/
/web/server/.venv/
/web/client/test-results/
/web/client/playwright-report/
/web/client/*.tsbuildinfo

# The web app's SESSION data: the projects a user saved, the job records, the
# result files and the logs. These are what the app writes when it runs, not
# source: 106 MB of binaries and JSON carrying the absolute paths of the
# machine that happened to run it. The app reads them from KATAI_DATA_DIR
# (the deployment sets /var/lib/katai-web), and the e2e suite points that at
# its own scratch directory, so nothing in the repository needs them tracked.
# The files stay on disk; they stop being part of the history.
/web/data/

# Working notes (formulation and validation prose, environment and decision
# journals) stay out of the tracked tree; they feed the project website
# instead. What stays tracked is what the tests pin to the code: the .k2d
# format spec, the machine schema, and the generated verification matrix.
/docs/ARCHITECTURE.md
/docs/DECISIONS.md
/docs/ENVIRONMENT.md
/docs/how-to-design-codes.md
/docs/references/
/docs/internal/
/docs/validation/*
!/docs/validation/verification-matrix.md
!/docs/validation/references.bib
!/docs/validation/numerical-uncertainty.md
!/docs/validation/three-published-benchmarks.md
# PLAXIS-parity verification record (plaxis-parity plan): the generated report and
# the baseline it is measured against are part of the verification record.
!/docs/validation/plaxis-parity-report.md
!/docs/validation/baseline-2026-11-05.md

# Python bytecode cache (a test importing a script must not pollute the source tree;
# the tests also set PYTHONDONTWRITEBYTECODE, this is the belt for manual runs)
__pycache__/
*.pyc

# IDE / editor
/.vs/
/.vscode/
*.user

# Local ccache directory (if present)
/.cache/

# OS
Thumbs.db
.DS_Store

# Articles written for outside publication (LinkedIn, blog): prose about the
# program rather than part of it, and revised on a different clock from the
# code. They cite the tracked verification material instead of duplicating it.
/articles/
